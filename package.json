{
  "name": "pickriders",
  "version": "0.1.1",
  "description": "The official Pickriders SDK: book deliveries and follow them to the door, in TypeScript or JavaScript, on the server and in the browser.",
  "keywords": [
    "pickriders",
    "delivery",
    "logistics",
    "dispatch",
    "courier",
    "riders",
    "nigeria",
    "api",
    "sdk",
    "webhooks"
  ],
  "homepage": "https://github.com/Pickriders/pickriders-node-sdk#readme",
  "bugs": "https://github.com/Pickriders/pickriders-node-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pickriders/pickriders-node-sdk.git"
  },
  "license": "MIT",
  "author": "Pickriders",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sandbox": "vitest run test/sandbox.test.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "yarn build && publint --pack npm && attw --pack . --profile node16",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn check:package",
    "openapi:pull": "node scripts/pull-openapi.mjs",
    "generate": "openapi-typescript openapi/developer-openapi.json -o src/generated/openapi.ts --default-non-nullable false",
    "changeset": "changeset",
    "release": "yarn validate && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
